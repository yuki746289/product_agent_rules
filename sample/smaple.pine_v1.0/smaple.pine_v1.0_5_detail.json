    {"id": "O103", "type": "ADD", "name": "ema3Value", "dataType": "series float", "description": "EMA3 の値。"},
    {"id": "O104", "type": "ADD", "name": "inputSettings", "dataType": "inputs", "description": "TradingView 設定画面で編集可能な入力群。"},
    {"id": "O105", "type": "ADD", "name": "plotEma1", "dataType": "plot", "description": "EMA1 ライン。"},
    {"id": "O106", "type": "ADD", "name": "plotEma2", "dataType": "plot", "description": "EMA2 ライン。"},
    {"id": "O107", "type": "ADD", "name": "plotEma3", "dataType": "plot", "description": "EMA3 ライン。"}
  ],
  "variables": [
    {"id": "V101", "type": "ADD", "name": "sourceInput", "dataType": "series float", "description": "入力価格ソース。"},
    {"id": "V102", "type": "ADD", "name": "ema1LengthInput", "dataType": "int", "description": "EMA1 期間。"},
    {"id": "V103", "type": "ADD", "name": "ema2LengthInput", "dataType": "int", "description": "EMA2 期間。"},
    {"id": "V104", "type": "ADD", "name": "ema3LengthInput", "dataType": "int", "description": "EMA3 期間。"},
    {"id": "V105", "type": "ADD", "name": "ema1ColorInput", "dataType": "color", "description": "EMA1 色。"},
    {"id": "V106", "type": "ADD", "name": "ema2ColorInput", "dataType": "color", "description": "EMA2 色。"},
    {"id": "V107", "type": "ADD", "name": "ema3ColorInput", "dataType": "color", "description": "EMA3 色。"},
    {"id": "V108", "type": "ADD", "name": "lineWidthInput", "dataType": "int", "description": "線幅。"},
