{
  "version": "1.0",
  "summary": "TradingView のチャート上に EMA を3本表示する Pine Script インジケーターを新規作成する。",
  "features": [
    {"id": "L101", "sourceStepId": "S001", "type": "ADD", "summary": "Pine Script v6 とインジケーター宣言を行う。", "targetFunction": "global"},
    {"id": "L102", "sourceStepId": "S002", "type": "ADD", "summary": "入力設定を定義する。", "targetFunction": "global"},
    {"id": "L103", "sourceStepId": "S003", "type": "ADD", "summary": "selectEmaValue を使用して3本の EMA を計算する。", "targetFunction": "refreshEmaSeries"},
    {"id": "L104", "sourceStepId": "S004", "type": "ADD", "summary": "plot で3本の EMA を表示する。", "targetFunction": "global"}
  ],
  "functions": [
    {"id": "F101", "type": "ADD", "name": "refreshEmaSeries", "description": "3本分の EMA 算出を統括する主関数。"},
    {"id": "T101", "type": "ADD", "name": "selectEmaValue", "description": "指定された価格ソースと期間から EMA を1本計算する補助関数。"}
  ],
  "inputs": [
    {"id": "I101", "type": "ADD", "name": "sourceInput", "dataType": "series float", "description": "EMA 計算に使用する価格ソース。"},
    {"id": "I102", "type": "ADD", "name": "ema1LengthInput", "dataType": "int", "description": "EMA1 の期間。"},
    {"id": "I103", "type": "ADD", "name": "ema2LengthInput", "dataType": "int", "description": "EMA2 の期間。"},
    {"id": "I104", "type": "ADD", "name": "ema3LengthInput", "dataType": "int", "description": "EMA3 の期間。"},
    {"id": "I105", "type": "ADD", "name": "ema1ColorInput", "dataType": "color", "description": "EMA1 の表示色。"},
