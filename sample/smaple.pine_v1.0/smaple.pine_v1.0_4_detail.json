{
  "version": "1.0",
  "name": "smaple.pine",
  "summary": "TradingView のチャート上に EMA を3本表示する Pine Script インジケーターの詳細設計。",
  "steps": [
    {"id": "S001", "type": "ADD", "name": "indicatorDeclaration", "description": "Pine Script v6 のインジケーターとして overlay=true で宣言する。"},
    {"id": "S002", "type": "ADD", "name": "inputSettings", "description": "価格ソース、期間、色、線幅を入力として定義する。"},
    {"id": "S003", "type": "ADD", "name": "emaCalculation", "description": "3本の EMA を計算する。"},
    {"id": "S004", "type": "ADD", "name": "emaPlot", "description": "3本の EMA をチャート上に表示する。"}
  ],
  "features": [
    {"id": "L101", "sourceStepId": "S001", "type": "ADD", "summary": "Pine Script v6 とインジケーター宣言を行う。", "targetFunction": "global"},
    {"id": "L102", "sourceStepId": "S002", "type": "ADD", "summary": "入力設定を定義する。", "targetFunction": "global"},
    {"id": "L103", "sourceStepId": "S003", "type": "ADD", "summary": "selectEmaValue を使用して3本の EMA を計算する。", "targetFunction": "refreshEmaSeries"},
    {"id": "L104", "sourceStepId": "S004", "type": "ADD", "summary": "plot で3本の EMA を表示する。", "targetFunction": "global"}
  ],
  "functions": [
    {"id": "F101", "type": "ADD", "name": "refreshEmaSeries", "description": "3本分の EMA 算出を統括する主関数。", "arguments": ["I101", "I102", "I103", "I104"], "returns": ["O101", "O102", "O103"], "usedBy": ["L103"]},
    {"id": "T101", "type": "ADD", "name": "selectEmaValue", "description": "指定された価格ソースと期間から EMA を1本計算する補助関数。", "arguments": ["I101", "I102"], "returns": ["O101"], "usedBy": ["L103"]}
  ],
  "inputs": [
    {"id": "I101", "type": "ADD", "name": "sourceInput", "dataType": "series float", "description": "EMA 計算に使用する価格ソース。", "usedBy": ["F101", "T101"]},
    {"id": "I102", "type": "ADD", "name": "ema1LengthInput", "dataType": "int", "description": "EMA1 の期間。", "usedBy": ["F101", "T101"]},
    {"id": "I103", "type": "ADD", "name": "ema2LengthInput", "dataType": "int", "description": "EMA2 の期間。", "usedBy": ["F101"]},
    {"id": "I104", "type": "ADD", "name": "ema3LengthInput", "dataType": "int", "description": "EMA3 の期間。", "usedBy": ["F101"]},
    {"id": "I105", "type": "ADD", "name": "ema1ColorInput", "dataType": "color", "description": "EMA1 の表示色。", "usedBy": ["L104"]},
    {"id": "I106", "type": "ADD", "name": "ema2ColorInput", "dataType": "color", "description": "EMA2 の表示色。", "usedBy": ["L104"]},
    {"id": "I107", "type": "ADD", "name": "ema3ColorInput", "dataType": "color", "description": "EMA3 の表示色。", "usedBy": ["L104"]},
    {"id": "I108", "type": "ADD", "name": "lineWidthInput", "dataType": "int", "description": "EMA ラインの太さ。", "usedBy": ["L104"]}
  ],
  "outputs": [
    {"id": "O101", "type": "ADD", "name": "ema1Value", "dataType": "series float", "description": "EMA1 の値。", "usedBy": ["L103", "L104"]},
    {"id": "O102", "type": "ADD", "name": "ema2Value", "dataType": "series float", "description": "EMA2 の値。", "usedBy": ["L103", "L104"]},
    {"id": "O103", "type": "ADD", "name": "ema3Value", "dataType": "series float", "description": "EMA3 の値。", "usedBy": ["L103", "L104"]},
    {"id": "O104", "type": "ADD", "name": "inputSettings", "dataType": "inputs", "description": "TradingView 設定画面で編集可能な入力群。", "usedBy": ["L102"]},
    {"id": "O105", "type": "ADD", "name": "plotEma1", "dataType": "plot", "description": "EMA1 ライン。", "usedBy": ["L104"]},
    {"id": "O106", "type": "ADD", "name": "plotEma2", "dataType": "plot", "description": "EMA2 ライン。", "usedBy": ["L104"]},
    {"id": "O107", "type": "ADD", "name": "plotEma3", "dataType": "plot", "description": "EMA3 ライン。", "usedBy": ["L104"]}
  ],
  "variables": [
    {"id": "V101", "type": "ADD", "name": "sourceInput", "dataType": "series float", "description": "入力価格ソース。"},
    {"id": "V102", "type": "ADD", "name": "ema1LengthInput", "dataType": "int", "description": "EMA1 期間。"},
    {"id": "V103", "type": "ADD", "name": "ema2LengthInput", "dataType": "int", "description": "EMA2 期間。"},
    {"id": "V104", "type": "ADD", "name": "ema3LengthInput", "dataType": "int", "description": "EMA3 期間。"},
    {"id": "V105", "type": "ADD", "name": "ema1ColorInput", "dataType": "color", "description": "EMA1 色。"},
    {"id": "V106", "type": "ADD", "name": "ema2ColorInput", "dataType": "color", "description": "EMA2 色。"},
    {"id": "V107", "type": "ADD", "name": "ema3ColorInput", "dataType": "color", "description": "EMA3 色。"},
    {"id": "V108", "type": "ADD", "name": "lineWidthInput", "dataType": "int", "description": "線幅。"},
    {"id": "V109", "type": "ADD", "name": "ema1Value", "dataType": "series float", "description": "EMA1 計算結果。"},
    {"id": "V110", "type": "ADD", "name": "ema2Value", "dataType": "series float", "description": "EMA2 計算結果。"},
    {"id": "V111", "type": "ADD", "name": "ema3Value", "dataType": "series float", "description": "EMA3 計算結果。"}
  ],
  "constraints": [
    "Pine Script v6 を使用する。",
    "plot はグローバルスコープで呼び出す。",
    "期間と線幅は minval=1 とする。",
    "売買シグナル、アラート、strategy 処理は対象外とする。"
  ],
  "invariants": [
    "初版のため KEEP 対象なし。"
  ],
  "deleted_items": {
    "features": [],
    "functions": [],
    "inputs": [],
    "outputs": [],
    "variables": []
  }
}
