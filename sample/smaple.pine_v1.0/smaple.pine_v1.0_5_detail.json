    {"id": "I107", "type": "ADD", "name": "ema3ColorInput", "dataType": "color", "description": "EMA3 の表示色。"},
    {"id": "I108", "type": "ADD", "name": "lineWidthInput", "dataType": "int", "description": "EMA ラインの太さ。"}
